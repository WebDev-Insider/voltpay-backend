{
  "name": "ovopay-backend-api",
  "version": "1.0.0",
  "description": "Backend API service for OvoPay Flutter app with PostgreSQL",
  "main": "server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:pii": "node test/pii.helper.test.js",
    "test:recovery": "node test/recovery.helper.test.js",
    "test:lockout": "node test/loginLockout.helper.test.js",
    "test:auth-guards": "node test/authGuards.test.js",
    "test:admin-profile": "node test/adminUserProfile.test.js",
    "backfill:pii": "node scripts/backfill-pii.js",
    "backfill:statements": "node scripts/backfill-statements.js",
    "backfill:statements:verify": "node scripts/backfill-statements.js --verify",
    "push:test": "node scripts/send-test-push.js",
    "test:upload": "node test/upload.helper.test.js",
    "test:redis": "node test/redis.service.test.js",
    "test:cache": "node test/cache.service.test.js",
    "test:bills": "node test/planDuration.test.js && node test/bills.controller.test.js && node test/billSettlement.test.js && node test/mysubwallet.service.test.js && node test/mysubwalletFlows.test.js && node test/betting.test.js && node test/bettingFlow.test.js",
    "test:account": "node test/accountStatus.helper.test.js && node test/accountDeletion.test.js",
    "ddl:account-deletion": "node scripts/apply-account-deletion-ddl.js",
    "test:credit-alert": "node test/creditAlert.test.js",
    "test:funding-nin": "node test/fundingNin.test.js",
    "test:funding-accounts": "node test/fundingAccounts.test.js",
    "check:fcm": "node scripts/check-fcm.js",
    "test:campaign": "node test/notificationCampaign.test.js",
    "test:export": "node test/transactions.export.test.js",
    "test:statement-pdf": "node test/statementPdf.helper.test.js",
    "test:request-money": "node test/requestMoney.controller.test.js",
    "test:staffpay": "node test/staffpayAccess.test.js && node test/staffpayDue.helper.test.js && node test/staffpayPayroll.test.js && node test/staffpayRecovery.test.js && node test/staffpayScheduler.test.js",
    "test:insights": "node test/spendingInsights.test.js && node test/statements.controller.test.js",
    "test:billhero": "node test/billHero.controller.test.js && node test/billHeroAvailability.test.js && node test/billHeroChallenge.test.js && node test/adminBillHeroDataPlans.test.js && node test/billHeroDelivery.test.js",
    "test:scheduled-topups": "node test/topupSchedule.helper.test.js && node test/scheduledTopupFlow.test.js",
    "ddl:scheduled-topups": "node scripts/apply-scheduled-topups-ddl.js",
    "test:airtime-cash": "node test/airtimeCashProvider.test.js && node test/airtimeCash.test.js",
    "ddl:airtime-cash": "node scripts/apply-airtime-cash-ddl.js",
    "a2c:reconcile": "node scripts/airtime-cash-reconcile.js",
    "test:cac": "node test/cac.test.js && node test/cacDdl.test.js",
    "test:platform": "node test/platformFixes.test.js",
    "ddl:cac": "node scripts/apply-cac-ddl.js",
    "test:virtual-card": "node test/virtualCard.test.js",
    "ddl:virtual-card": "node scripts/apply-virtual-card-ddl.js",
    "test:champions": "node test/adminBillChampions.test.js",
    "ddl:bill-champions-index": "node scripts/apply-bill-champions-index-ddl.js",
    "test:hardening": "node test/hardening.test.js",
    "test:fraud": "node test/fraudControls.test.js",
    "test:aml": "node test/adminAml.test.js",
    "ddl:aml-index": "node scripts/apply-aml-index-ddl.js",
    "test:kyc": "node test/kyc.test.js",
    "test:kyc-flow": "node test/kycFlow.e2e.test.js",
    "ddl:kyc": "node scripts/apply-kyc-ddl.js",
    "notify:kyc-nin-required": "node scripts/notify-kyc-nin-required.js",
    "notify:kyc-one-document": "node scripts/notify-kyc-one-document.js",
    "test:idempotency": "node test/idempotency.middleware.test.js",
    "ddl:idempotency": "node scripts/apply-idempotency-ddl.js",
    "ddl:staffpay-paidat": "node scripts/apply-staffpay-paidat-ddl.js",
    "test:admin-accounts": "node test/adminAccounts.test.js",
    "test:admin-webauthn": "node test/adminWebauthn.test.js && node test/adminPasskeyFlow.test.js",
    "apply:audit-ddl": "node scripts/apply-audit-ddl.js",
    "apply:admin-ddl": "node scripts/apply-admin-ddl.js",
    "ddl:admin-webauthn": "node scripts/apply-admin-webauthn-ddl.js",
    "admin:create": "node scripts/create-admin.js",
    "insights:dry": "node scripts/send-spending-insights.js --dry",
    "insights:send": "node scripts/send-spending-insights.js",
    "test:transactions": "node test/adminTransactions.test.js",
    "test:provider-failures": "node test/providerFailuresClear.test.js",
    "test:recovery-admin": "node test/adminRecovery.test.js",
    "test:app-update": "node test/appUpdate.helper.test.js",
    "test:version-gate": "node test/appVersionGate.middleware.test.js",
    "test:email": "node test/emailTemplate.test.js",
    "email:preview": "node scripts/preview-emails.js --open"
  },
  "keywords": [
    "api",
    "express",
    "ovopay",
    "flutter",
    "postgresql"
  ],
  "author": "Henry Dustin",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.4.1",
    "@prisma/extension-accelerate": "^1.3.0",
    "bcryptjs": "^2.4.3",
    "bip39": "^3.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "prisma": "^7.4.1",
    "resend": "^6.2.2",
    "undici": "^7.22.0",
    "uploadthing": "^7.7.4",
    "win-ca": "^3.5.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "effect": "3.18.4"
  }
}
