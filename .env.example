# Where this API answers from, as the outside world sees it. Providers build
# their callback URLs from it, so it must be a host reachable from the internet
# - the Render URL in production, an ngrok tunnel in development. A localhost
# value silently breaks every asynchronous verdict: BudPay accepts the BVN
# submission and posts the result nowhere.
PUBLIC_BASE_URL=
API_PREFIX=/api

# PairGate - airtime, data, cable TV and electricity, plus Bill Hero rewards.
# Prepaid: vending draws on a float held with PairGate, so an unfunded balance
# fails every purchase regardless of what the customer's wallet holds.
PAIRGATE_API_KEY=
PAIRGATE_BASE_URL=https://pairgate.com/api/v1
PAIRGATE_TIMEOUT_MS=30000
# The rate limit is 60 calls a minute for the whole key, shared by catalogue
# reads and live vending, with a per-second limit underneath it. Caching the
# catalogue for half an hour is what keeps browsing from starving purchases.
PAIRGATE_CATALOGUE_TTL_MS=1800000
# How long a catalogue stays servable after it stops being fresh. A stale copy is
# returned instantly and refreshed behind the request, so nobody waits on a
# provider round trip for a list four other customers already have. Only actually
# consumed when the refresh keeps failing - PairGate being down - where the
# choice is a slightly old price or no bills screen at all.
PAIRGATE_STALE_GRACE_MS=1800000
# Minimum gap between catalogue calls. Loading one network's data plans is a
# categories call plus one call per plan family; fired back to back the second
# answers 429 "Please wait 1 seconds", which costs the round trip AND the 1.25s
# the retry then sleeps. Spacing them is strictly faster than colliding. Applies
# to catalogue reads only - a vend never queues behind someone else's plan list.
PAIRGATE_CATALOGUE_GAP_MS=1100
# Catalogues are warmed at boot and replaced on this interval, so the refresh is
# paid by the server on a timer and never by the customer who opened the bills
# screen first. Keep it below PAIRGATE_CATALOGUE_TTL_MS so the value is renewed
# before it can go stale. One instance warms per cycle (Redis lock).
PAIRGATE_WARM_INTERVAL_MS=1500000
# How long after boot the first pass runs, plus a random spread on top of it. The
# spread is what stops a deploy of N instances calling PairGate on the same
# second: the boot pass does not force, so an instance starting a little behind
# another reads every catalogue back out of Redis and makes no provider calls at
# all. Only useful staggered - with identical delays they arrive together and all
# miss. The boot log prints the provider-call count, against a budget of 60 a
# minute shared by every process using the key.
PAIRGATE_WARM_DELAY_MS=3000
PAIRGATE_WARM_JITTER_MS=5000
# Signs delivery notifications (HMAC-SHA256 over "<timestamp>.<raw body>"). Set
# it, and set the same value in the PairGate dashboard. Left empty the webhook
# still works, but it can no longer trust its own body: every delivery costs an
# extra status call, and a token arriving on an unsigned POST is taken on faith.
PAIRGATE_WEBHOOK_SECRET=
# 1 routes vends to PairGate's sandbox. Never set in production - it returns
# success without delivering anything.
PAIRGATE_TEST_MODE=
# Where the float is topped up from, shown on the admin Providers screen so
# whoever is on call can transfer without hunting for the details. Not a secret
# - money only travels toward it - but config, because PairGate can reassign it.
PAIRGATE_FUNDING_BANK=Paystack-Titan
PAIRGATE_FUNDING_ACCOUNT_NUMBER=9604484109
PAIRGATE_FUNDING_ACCOUNT_NAME=Pairgateventu/technology jade
# Float levels, in naira. At or below LOW the dashboard says top up today; at or
# below CRITICAL it says vending is about to fail. Set LOW to roughly a busy
# day's bills turnover.
PAIRGATE_FLOAT_LOW_NGN=25000
PAIRGATE_FLOAT_CRITICAL_NGN=5000

# ---------------------------------------------------------------------------
# ClubKonnect - the second bills provider.
# ---------------------------------------------------------------------------
# Same four rails as PairGate (airtime, data, cable TV, electricity) and nothing
# else. Betting stays on Payvessel and is not reachable from here.
#
# Which provider each rail vends through is chosen in the admin dashboard
# (Providers screen), not here - leaving these blank simply means ClubKonnect
# cannot be selected, and the switch says so rather than failing at purchase
# time. Both keys are required before it becomes selectable.
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com
CLUBKONNECT_TIMEOUT_MS=30000
# Their API only answers requests from whitelisted source IPs. On a host with a
# rotating outbound address (Render's default) every call fails until a static
# outbound IP is configured and registered with ClubKonnect. This is the one
# prerequisite that cannot be fixed from inside the app.
#
# Where they post delivery notifications. Sent per order rather than configured
# in their dashboard, so it must be the public URL of THIS deployment.
# Unlike PairGate there is no signature scheme, so a callback is never trusted
# on its own - every outcome is re-read over the authenticated API before a
# naira moves. Leaving it blank is safe: the receipt poll and the sweep still
# settle every order, just later.
CLUBKONNECT_CALLBACK_URL=
# Catalogue caching, same shape as PairGate's. The in-process tier is
# deliberately far shorter than the Redis tier - equal TTLs would let an
# instance hold a price 30 minutes past its expiry, and a catalogue price is
# what the customer is charged.
CLUBKONNECT_CATALOGUE_TTL_MS=1800000
CLUBKONNECT_LOCAL_TTL_MS=60000
CLUBKONNECT_STALE_GRACE_MS=1800000
CLUBKONNECT_CATALOGUE_GAP_MS=1100
# Where this float is topped up from, shown beside PairGate's on the admin
# Providers screen. Not a secret - money only travels toward it.
CLUBKONNECT_FUNDING_BANK=
CLUBKONNECT_FUNDING_ACCOUNT_NUMBER=
CLUBKONNECT_FUNDING_ACCOUNT_NAME=
# Float levels, in naira. Read the same way as PairGate's: at or below LOW the
# dashboard says top up today, at or below CRITICAL it says vending on every
# rail pointed here is about to fail.
CLUBKONNECT_FLOAT_LOW_NGN=25000
CLUBKONNECT_FLOAT_CRITICAL_NGN=5000

# ---------------------------------------------------------------------------
# Bills provider switching
# ---------------------------------------------------------------------------
# How long a rail's chosen provider is cached before the switch is re-read.
# Short on purpose - an admin moving a rail away from a failing provider is
# doing it during an incident, and a switch that takes ten minutes is not a
# switch. The stored choice itself lives in app_settings, one row per rail.
BILLS_PROVIDER_TTL_SECONDS=30
# Minimum gap before a bill sitting in "processing" is requeried, so the receipt
# poll cannot turn a slow provider into a call storm. Falls back to
# PAIRGATE_RECHECK_MS, then to 15s.
BILLS_RECHECK_MS=15000
# Dearest network price a Bill Hero data reward may cost to deliver. Keeps the
# 480GB / NGN 90,000 end of PairGate's catalogue out of the reward dropdown.
BILL_HERO_MAX_REWARD_COST_NGN=6000
UPLOADTHING_TOKEN=your_uploadthing_token
# Browser origins allowed to call the API - the admin dashboard and Flutter web,
# comma separated, no trailing slash. Empty allows every origin, which is fine
# in dev and must not ship. The mobile app sends no Origin and is unaffected.
CORS_ALLOWED_ORIGINS=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
USER_CACHE_TTL_SECONDS=15
REFERENCE_CACHE_TTL_SECONDS=600
# Must clear the real round trip to your Upstash region, with room for the first
# call of a process paying DNS + TLS. Too low is not a smaller optimisation, it
# is a negative one: an aborted call costs the whole budget and then the Postgres
# query it was meant to replace, and five in a row open the breaker - which takes
# the shared rate-limit counters, the login lockout and pending confirmations
# down to per-process memory with it. Co-located with the app, 250 is plenty;
# from a laptop on another continent it aborts calls Upstash answered fine.
REDIS_TIMEOUT_MS=1200

# Firebase Cloud Messaging (HTTP v1). Service account JSON from
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the raw JSON on one line, or base64 it if the dashboard mangles the
# private key newlines. Never commit this value.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Weekly/monthly spending summaries. On unless set to false. The hour is WAT and
# is a floor, not an exact match - the summary is keyed on the period, so a late
# tick still sends and a repeat tick does not.
SPENDING_INSIGHTS_ENABLED=true
SPENDING_INSIGHTS_HOUR_WAT=9
SPENDING_INSIGHTS_INTERVAL_MS=3600000

# Error tracking and payment-failure alerting. Unset = console only, which is
# still a working API - alerting must never be able to fail a payment. The URL
# is a Slack or Discord incoming webhook; the same message body suits both.
ALERT_WEBHOOK_URL=
# Identical failures inside this window are counted, not re-sent.
ALERT_THROTTLE_MS=300000
ALERT_TIMEOUT_MS=5000

# Exponential backoff on provider calls. Applies to reads only - a vend or a
# transfer that timed out is settled by reconciliation, never by a second POST.
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=300
PROVIDER_RETRY_MAX_MS=4000

# Unattended retry of failed staff transfers: 5 min, then 20, then 80, then it
# waits for the manual retry button.
STAFFPAY_MAX_AUTO_RETRIES=3
STAFFPAY_RETRY_BASE_MS=300000
STAFFPAY_RETRY_MAX_MS=21600000

# Automatic payroll. Both flags are required before a salary goes out on its
# own, and the process running them must be always-on - the scheduler refuses
# to start on a serverless runtime, where a timer does not survive the response.
# Safe to enable on several instances: every item carries a cycle key that the
# database refuses to duplicate, so only one of them can pay a given payday.
STAFFPAY_SCHEDULER_ENABLED=false
STAFFPAY_AUTOPAY_ENABLED=false
STAFFPAY_SCHEDULER_DEBUG=false
# How often the loop wakes, and how many staff one run pays. Transfers inside a
# run are submitted one at a time, so the batch size is what stops a very large
# company from holding the loop; the remainder is paid on the next tick.
STAFFPAY_SYNC_INTERVAL_MS=60000
STAFFPAY_PAYROLL_BATCH_SIZE=200
STAFFPAY_DEFAULT_PAYOUT_TIME=09:00
# How long a payroll run may sit with unsent transfers before another instance
# treats it as abandoned by a dead process and finishes it. Also how long a
# Paystack "unknown reference" must persist before the salary is refunded.
# Shorter than a slow run takes and the sweep starts fighting a live process.
STAFFPAY_STRANDED_AFTER_MS=600000

# Cooling period between "delete my account" and the data actually going.
# Reactivating inside the window cancels it. 0 means immediate - don't.
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_PURGE_INTERVAL_MS=3600000

# Velocity limits: the ceiling on money leaving one wallet, regardless of how
# valid each individual payment is. This is the control that catches a stolen
# handset with a known PIN. Counted from wallet_transactions, not from Redis.
VELOCITY_ENABLED=1
VELOCITY_HOURLY_MAX_COUNT=12
VELOCITY_HOURLY_MAX_AMOUNT=500000
VELOCITY_DAILY_MAX_AMOUNT=2000000

# KYC gate. Triggered by money coming IN: a wallet that has received
# KYC_FUNDING_LIMIT naira or more into its virtual account without a verified
# identity is frozen - no bills, airtime, data, electricity, betting or
# transfers - until verification clears.
#
# Verification is TWO requirements, and it is an AND:
#   1. an identity document - a Payvessel-verified BVN (seconds), OR a NIN slip
#      an admin has reviewed and approved (a day or two)
#   2. a bank account Paystack resolved to a name matching the profile
#
# MODE=lifetime totals every credit ever received; MODE=single only looks at the
# largest one, which anyone can defeat by splitting a deposit, so lifetime is
# the default.
KYC_GATE_ENABLED=1
KYC_FUNDING_LIMIT=25000
KYC_FUNDING_LIMIT_MODE=lifetime

# Is requirement 2 above enforced? ON, and it should stay on - the identity
# document says who someone is, the bank account says where they bank, and the
# second is what a refund, a payout or a trace actually needs. It is also free
# and instant.
#
# A bank account is never a route in on its own and cannot be made one: Paystack
# /bank/resolve answers for ANY account number, so it proves the account exists
# and who owns it, never that the person asking is that person.
#
# Set to 0 ONLY on a deployment that already has verified users from before this
# rule, where turning it on would freeze live wallets whose owners were never
# asked for an account. Check before you decide:
#   SELECT count(*) FROM kyc_verifications
#    WHERE (status = 'verified' OR nin_slip_status = 'approved')
#      AND account_status <> 'verified';
# It was 0 when this shipped.
KYC_BANK_REQUIRED=1

# BudPay identity verification - RETIRED. KYC moved back to Payvessel (below),
# which checks a BVN and a NIN, and the bank-account requirement was withdrawn
# with it. Nothing reads these; src/funding/budpay.service.js is unreferenced.
# Left here because the integration still works and the bank name-resolution
# half has no replacement - restoring it means restoring these.
# BUDPAY_SECRET_KEY=
# BUDPAY_BASE_URL=https://api.budpay.com/api/v2
# BUDPAY_TIMEOUT_MS=30000
# BUDPAY_BANK_CACHE_MS=86400000
# BUDPAY_STRICT_NAME=0
# Retired with the callback. Payvessel is synchronous, so no submission ever
# sits `pending` and there is nothing to release.
# KYC_BVN_PENDING_STALE_MINUTES=30
# Edit distance tolerated per name token when matching a document against the
# profile name. 2 absorbs a slipped keystroke in a long Nigerian name; 0 turns
# the check into exact string equality and generates tickets. STILL LIVE.
KYC_NAME_MAX_EDITS=2

# Payvessel - the live KYC rail. Both checks (BVN and NIN) are SYNCHRONOUS: the
# verdict is in the HTTP response, so there is no callback and PUBLIC_BASE_URL
# is irrelevant to this path. Auth is two flat headers, api-key + api-secret;
# both are secret. The same key pair authenticates the VAAS/betting rail below.
#
# ⚠ Payvessel is PREPAID, and it bills a failed match and a "not found" exactly
# as it bills a pass. An empty balance answers 402, which the app surfaces as
# "temporarily unavailable" and which leaves the user's record untouched rather
# than marking them failed. This is what took the rail down last time - keep the
# balance funded and watch for kyc.* 503s in the logs.
PAYVESSEL_API_KEY=
PAYVESSEL_API_SECRET=
# https://sandbox.payvessel.com/kyc while testing.
PAYVESSEL_BASE_URL=https://api.payvessel.com/kyc
# Name-similarity floor, in percent. Below this the check is a decline.
# DO NOT RAISE THIS TO 70. Measured on a live three-name BVN (2026-08-25):
# Payvessel's BVN endpoint ignores `middle_name` entirely and scores
# (names matched / names on the register) over first and last only, so a
# three-name record CANNOT EXCEED 66 however perfectly it is filled in. At 70 no
# such customer can ever verify, and each pays N30 to find out. 65 accepts 66 and
# 100 while still declining a half match at 50 or 33. Full evidence in the
# NAME_MATCH_MIN comment in src/funding/payvessel.service.js.
PAYVESSEL_NAME_MATCH_MIN=65
# Payvessel biller reseller - the betting rail. Same api-key / api-secret pair
# as above, different host prefix, so only the base URL is separate.
# https://sandbox.payvessel.com while testing.
PAYVESSEL_VAAS_BASE_URL=https://api.payvessel.com
# Payvessel's floor for a betting order. A biller that publishes its own
# min_amount overrides this.
PAYVESSEL_BETTING_MIN_AMOUNT=100
# How often the server re-checks betting orders left processing. This is what
# refunds a failed order when the webhook never arrives, so do not disable it.
BETTING_SWEEP_INTERVAL_MS=300000

# Kill switch cache. Deliberately short - a switch that takes ten minutes to
# take effect is not a kill switch. Flags themselves live in app_settings and
# are thrown from PATCH /admin/features/:slug.
FEATURE_FLAG_TTL_SECONDS=30

# Named admin keys: "name:role:key,name:role:key". Roles: support, finance,
# superadmin. Set this in production - it is what puts a name in the audit trail
# and lets one admin be removed without rotating everyone's access.
# ADMIN_API_SECRET below still works and authenticates as an anonymous
# superadmin, which is exactly the problem this replaces.
#
# Both are now superseded by real admin accounts (admin_users). Once every human
# has one, set ADMIN_ALLOW_STATIC_KEYS=0 and neither header is accepted again.
ADMIN_API_KEYS=

# Signs admin session tokens. Required for /admin/auth/login, and MUST be a
# different value from JWT_SECRET - a leaked customer token secret must not be
# able to mint admin sessions. 32+ random bytes.
ADMIN_JWT_SECRET=
# Admin sessions are short by design; the dashboard signs in again.
ADMIN_JWT_EXPIRES_IN=12h
# Set to 0 to reject ADMIN_API_KEYS / ADMIN_API_SECRET and accept only real
# admin accounts. Do this once the first superadmin can log in.
ADMIN_ALLOW_STATIC_KEYS=1
