# Where this API answers from, as the outside world sees it. Providers build
# their callback URLs from it, so it must be a host reachable from the internet
# - the Render URL in production, a tunnel in development. A localhost value
# silently breaks every provider callback: the provider accepts the request and
# posts the result nowhere.
PUBLIC_BASE_URL=
API_PREFIX=/api

# ---------------------------------------------------------------------------
# MySubWallet - every bill: airtime, data, cable TV, electricity, and Bill Hero
# rewards. (PairGate and ClubKonnect were removed in October 2026. Betting is
# NOT here - it stays on Payvessel, below.)
# ---------------------------------------------------------------------------
# Prepaid: vending draws on our wallet at mysubwallet.ng, so an unfunded balance
# fails every purchase on every rail at once, whatever the customer's wallet
# holds. The key is the AccessToken from their dashboard (or POST /api/user).
# Required - without it every rail refuses at the admin switch and at purchase.
MYSUBWALLET_API_KEY=
# https://sandbox.mysubwallet.ng (or a sk_test_ key) simulates every purchase
# as a success and delivers nothing. Both are refused when NODE_ENV=production.
MYSUBWALLET_BASE_URL=https://api.mysubwallet.ng
MYSUBWALLET_TIMEOUT_MS=30000
# Airtime to Cash step 3 only. The network moves the airtime before answering,
# and a live conversion outran 30s (2026-10-12); a timeout there is an unknown a
# person has to settle, so it waits longer than a vend. Never applied to a vend.
MYSUBWALLET_CASH_TIMEOUT_MS=90000
# Delivery notifications are OPTIONAL and need no variable here. Their docs say
# a callback URL is set on their dashboard, but the dashboard offered no such
# setting as of 2026-10-06. Nothing depends on it: most purchases answer on the
# purchase call itself, and a pending one is settled by the receipt poll and
# the bills sweep, which ask MySubWallet directly. If the setting appears, point
# it at <PUBLIC_BASE_URL><API_PREFIX>/bills/webhook/mysubwallet.
#
# Catalogue caching. Each list arrives whole in one call, so a full warm pass is
# four calls. The in-process tier is deliberately far shorter than the Redis
# tier - equal TTLs would let an instance hold a price 30 minutes past its
# expiry, and a catalogue price is what the customer is charged.
MYSUBWALLET_CATALOGUE_TTL_MS=1800000
MYSUBWALLET_LOCAL_TTL_MS=60000
# How long a catalogue stays servable after it stops being fresh. A stale copy
# is returned instantly and refreshed behind the request; only really consumed
# when the refresh keeps failing, where the choice is a slightly old price or no
# bills screen at all.
MYSUBWALLET_STALE_GRACE_MS=1800000
# Minimum gap between catalogue calls. Catalogue reads only - a vend never
# queues behind someone else's plan list.
MYSUBWALLET_CATALOGUE_GAP_MS=400
# A purchase whose answer could not be read (timeout, dropped connection, 5xx)
# is requeried by its request-id after this pause, before anyone refunds it.
MYSUBWALLET_RECOVERY_DELAY_MS=2000
# Where the float is topped up from, shown on the admin Providers screen so
# whoever is on call can transfer without hunting for the details. Not a secret
# - money only travels toward it - but config, because it can be reassigned.
MYSUBWALLET_FUNDING_BANK=
MYSUBWALLET_FUNDING_ACCOUNT_NUMBER=
MYSUBWALLET_FUNDING_ACCOUNT_NAME=
# Float levels, in naira. At or below LOW the dashboard says top up today; at or
# below CRITICAL it says vending is about to fail. Set LOW to roughly a busy
# day's bills turnover - one float now carries every bills rail.
MYSUBWALLET_FLOAT_LOW_NGN=25000
MYSUBWALLET_FLOAT_CRITICAL_NGN=5000

# ---------------------------------------------------------------------------
# Bills provider registry
# ---------------------------------------------------------------------------
# How long a rail's chosen provider is cached before the switch is re-read.
# Only one provider is registered today; the switch matters again the day a
# second one is. The stored choice lives in app_settings, one row per rail.
BILLS_PROVIDER_TTL_SECONDS=30
# Minimum gap before a bill sitting in "processing" is requeried, so the receipt
# poll cannot turn a slow provider into a call storm.
BILLS_RECHECK_MS=15000
# Catalogues are warmed at boot and replaced on this interval, so the refresh is
# paid by the server on a timer and never by the customer who opened the bills
# screen first. Keep it below MYSUBWALLET_CATALOGUE_TTL_MS so the value is
# renewed before it can go stale. One instance warms per cycle (Redis lock).
BILLS_WARM_INTERVAL_MS=1500000
# How long after boot the first pass runs, plus a random spread on top, so a
# deploy of N instances does not call the provider on the same second.
BILLS_WARM_DELAY_MS=3000
BILLS_WARM_JITTER_MS=5000
# Dearest network price a Bill Hero data reward may cost to deliver. Keeps the
# 480GB / NGN 90,000 end of the data catalogue out of the reward dropdown.
BILL_HERO_MAX_REWARD_COST_NGN=6000
# How often the server finishes Bill Hero rewards the provider accepted but has
# not confirmed: confirms them, re-sends failed ones, and hands back any that
# cannot be delivered. It is the only thing that does, since the provider's
# webhook cannot be configured - do not disable it.
BILL_HERO_REWARD_SWEEP_INTERVAL_MS=300000
UPLOADTHING_TOKEN=your_uploadthing_token
# Browser origins allowed to call the API - the admin dashboard and Flutter web,
# comma separated, no trailing slash. Empty allows every origin, which is fine
# in dev and must not ship. The mobile app sends no Origin and is unaffected.
# Admin fingerprint sign-in reads the dashboard's address from here too.
CORS_ALLOWED_ORIGINS=
# Optional overrides for admin fingerprint sign-in, only if the list above is
# not where the dashboard lives. Every passkey is tied to the dashboard's
# hostname: change the address and admins set their fingerprint up again.
# ADMIN_WEBAUTHN_ORIGINS=https://voltpay-dashboard.vercel.app
# ADMIN_WEBAUTHN_RP_ID=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
USER_CACHE_TTL_SECONDS=15
REFERENCE_CACHE_TTL_SECONDS=600
# Must clear the real round trip to your Upstash region, with room for the first
# call of a process paying DNS + TLS. Too low is not a smaller optimisation, it
# is a negative one: an aborted call costs the whole budget and then the Postgres
# query it was meant to replace, and five in a row open the breaker - which takes
# the shared rate-limit counters, the login lockout and pending confirmations
# down to per-process memory with it. Co-located with the app, 250 is plenty;
# from a laptop on another continent it aborts calls Upstash answered fine.
REDIS_TIMEOUT_MS=1200

# Firebase Cloud Messaging (HTTP v1). Service account JSON from
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the raw JSON on one line, or base64 it if the dashboard mangles the
# private key newlines. Never commit this value.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Weekly/monthly spending summaries. On unless set to false. The hour is WAT and
# is a floor, not an exact match - the summary is keyed on the period, so a late
# tick still sends and a repeat tick does not.
SPENDING_INSIGHTS_ENABLED=true
SPENDING_INSIGHTS_HOUR_WAT=9
SPENDING_INSIGHTS_INTERVAL_MS=3600000

# Error tracking and payment-failure alerting. Unset = console only, which is
# still a working API - alerting must never be able to fail a payment. The URL
# is a Slack or Discord incoming webhook; the same message body suits both.
ALERT_WEBHOOK_URL=
# Identical failures inside this window are counted, not re-sent.
ALERT_THROTTLE_MS=300000
ALERT_TIMEOUT_MS=5000

# Exponential backoff on provider calls. Applies to reads only - a vend or a
# transfer that timed out is settled by reconciliation, never by a second POST.
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=300
PROVIDER_RETRY_MAX_MS=4000

# Unattended retry of failed staff transfers: 5 min, then 20, then 80, then it
# waits for the manual retry button.
STAFFPAY_MAX_AUTO_RETRIES=3
STAFFPAY_RETRY_BASE_MS=300000
STAFFPAY_RETRY_MAX_MS=21600000

# Automatic payroll. Both flags are required before a salary goes out on its
# own, and the process running them must be always-on - the scheduler refuses
# to start on a serverless runtime, where a timer does not survive the response.
# Safe to enable on several instances: every item carries a cycle key that the
# database refuses to duplicate, so only one of them can pay a given payday.
STAFFPAY_SCHEDULER_ENABLED=false
STAFFPAY_AUTOPAY_ENABLED=false
STAFFPAY_SCHEDULER_DEBUG=false
# How often the loop wakes, and how many staff one run pays. Transfers inside a
# run are submitted one at a time, so the batch size is what stops a very large
# company from holding the loop; the remainder is paid on the next tick.
STAFFPAY_SYNC_INTERVAL_MS=60000
STAFFPAY_PAYROLL_BATCH_SIZE=200
STAFFPAY_DEFAULT_PAYOUT_TIME=09:00
# Scheduled top-ups: standing airtime/data orders bought on a one-minute tick in
# Lagos time. Opt-in, and the process must be always-on - the worker refuses to
# start on a serverless runtime. Safe on several instances: each cycle is claimed
# once in the database. Tables: `npm run ddl:scheduled-topups`.
SCHEDULED_TOPUPS_ENABLED=false
SCHEDULED_TOPUPS_INTERVAL_MS=60000
# Minutes between retries of one cycle (low balance, our own outage). Three
# retries is what the confirm screen promises; the attempt count follows this.
SCHEDULED_TOPUPS_RETRY_MINUTES=60,180,360
# Ceiling on one run, and on live schedules per customer. A standing order
# repeats, so a ₦20,000-for-₦2,000 typo is paid every week until noticed.
SCHEDULED_TOPUPS_MAX_AMOUNT=50000
SCHEDULED_TOPUPS_MAX_PER_USER=10
# A slot this far in the past (the worker was off) is recorded as missed, not
# bought late. A Monday top-up arriving on Thursday is not what anybody asked for.
SCHEDULED_TOPUPS_MAX_LATENESS_MS=86400000

# Airtime to Cash: MTN/Airtel airtime sold through MySubWallet (POST /api/cash,
# Tier 2+ KYC on OUR MySubWallet account), paid out to the customer's bank by
# Paystack once an admin has funded Paystack and marked it available.
# Tables: `npm run ddl:airtime-cash`. Needs MYSUBWALLET_API_KEY and
# PAYSTACK_SECRET_KEY, with transfers enabled and transfer OTP switched OFF on
# the Paystack account. Kill switches: `airtime_cash` (new conversions) and
# `withdrawals` (payouts) on the admin Kill Switch screen.
#
# What the customer sees: rate as a fraction (0.75) or a percentage (75), and a
# flat naira fee. MTN 1,000 -> 1,000 x 75% - 100 = 650. Airtel 1,000 -> 700.
A2C_MTN_PAYOUT_RATE=0.75
A2C_MTN_FEE=100
A2C_AIRTEL_PAYOUT_RATE=0.70
A2C_AIRTEL_FEE=0
# What MySubWallet pays US - the margin column on the admin screen, never sent
# to the app. Airtel's is unpublished, so it defaults to the payout rate (a
# margin of 0, never an invented one). Set it once MySubWallet confirms it.
A2C_MTN_PROVIDER_RATE=0.75
A2C_AIRTEL_PROVIDER_RATE=0.70
# Whole naira of airtime. The tighter of max and daily wins.
A2C_MIN_AMOUNT=1000
A2C_MAX_AMOUNT=50000
A2C_DAILY_LIMIT=100000
# The code's lifetime on screen (the spec's one minute) and sends per attempt.
A2C_OTP_TTL_SECONDS=60
A2C_OTP_MAX_SENDS=5
# Digits in the code the network texts (4). The app draws this many boxes, so
# a network that changes it needs this value, not an app release.
A2C_OTP_LENGTH=4
# Both on by default. KYC because the wallet gate keys on funding, which this
# feature bypasses; own-name payouts because airtime cashed out to a stranger's
# account is what stolen airtime looks like. Turn off only deliberately.
A2C_REQUIRE_KYC=1
A2C_PAYOUT_OWN_NAME_ONLY=1
# The sweep: unanswered payouts, unconfirmed conversions, stale drafts, and
# conversions MySubWallet accepted that were never recorded.
A2C_SWEEP_INTERVAL_MS=300000
# Gap between the three in-request tries at recording a conversion MySubWallet
# answered; after those, timers at 30s / 2m / 5m, then the sweep.
A2C_RECORD_RETRY_MS=400
# Page ops when a converted conversion has waited this long for an admin unlock.
A2C_SETTLEMENT_ALERT_HOURS=24

# CAC Registration: business names, limited companies and incorporated
# trustees (NGOs). Tables: `npm run ddl:cac` - which also seeds the agreed
# starting prices (35,000 / 55,000 / 150,000) into the dashboard settings if
# none are set yet. PRICES ARE SET IN THE ADMIN DASHBOARD (CAC Registration ->
# Service settings), per type. The CAC_PRICE_* values below are only a bridge
# for a deployment whose admin has not saved one; the dashboard always wins.
# A type with no price anywhere shows "not available yet". Whole naira.
# CAC_PRICE_BUSINESS_NAME=
# CAC_PRICE_LIMITED_COMPANY=
# CAC_PRICE_INCORPORATED_TRUSTEES=
# Highest share capital a limited company may register with at the standard
# price (CAMA's minimum is 100,000). Above this, CAC fees and stamp duty grow.
CAC_MAX_SHARE_CAPITAL=1000000
# Paid by wallet (PIN) or Paystack checkout. Paystack's webhook is the one
# already configured for StaffPay (/api/staffpay/wallet/webhook) - CACPAY-
# references are routed from there. Where Paystack sends the browser back:
# defaults to ${PUBLIC_BASE_URL}/api/cac/paystack/callback.
# CAC_PAYSTACK_CALLBACK_URL=
# The sweep settles checkouts nobody verified and wipes drafts (form + the three
# documents) nobody came back to. 0 days keeps drafts forever.
CAC_SWEEP_INTERVAL_MS=300000
CAC_DRAFT_TTL_DAYS=14
# Kill switch: `cac_registration` on the admin Kill Switch screen (or the CAC
# settings card). It stops new applications and payments only.

# How long a payroll run may sit with unsent transfers before another instance
# treats it as abandoned by a dead process and finishes it. Also how long a
# Paystack "unknown reference" must persist before the salary is refunded.
# Shorter than a slow run takes and the sweep starts fighting a live process.
STAFFPAY_STRANDED_AFTER_MS=600000

# Cooling period between "delete my account" and the data actually going.
# Reactivating inside the window cancels it. 0 means immediate - don't.
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_PURGE_INTERVAL_MS=3600000

# Velocity limits: the ceiling on money leaving one wallet, regardless of how
# valid each individual payment is. This is the control that catches a stolen
# handset with a known PIN. Counted from wallet_transactions, not from Redis.
VELOCITY_ENABLED=1
VELOCITY_HOURLY_MAX_COUNT=12
VELOCITY_HOURLY_MAX_AMOUNT=500000
VELOCITY_DAILY_MAX_AMOUNT=2000000

# KYC gate. Triggered by money coming IN: a wallet that has received
# KYC_FUNDING_LIMIT naira or more into its virtual account without a verified
# identity is frozen - no bills, airtime, data, electricity, betting or
# transfers - until verification clears.
#
# Verification is TWO requirements, and it is an AND:
#   1. an identity document - a Payvessel-verified BVN (seconds), OR a NIN slip
#      an admin has reviewed and approved (a day or two)
#   2. a bank account Paystack resolved to a name matching the profile
#
# MODE=lifetime totals every credit ever received; MODE=single only looks at the
# largest one, which anyone can defeat by splitting a deposit, so lifetime is
# the default.
KYC_GATE_ENABLED=1
KYC_FUNDING_LIMIT=25000
KYC_FUNDING_LIMIT_MODE=lifetime

# Is requirement 2 above enforced? ON, and it should stay on - the identity
# document says who someone is, the bank account says where they bank, and the
# second is what a refund, a payout or a trace actually needs. It is also free
# and instant.
#
# A bank account is never a route in on its own and cannot be made one: Paystack
# /bank/resolve answers for ANY account number, so it proves the account exists
# and who owns it, never that the person asking is that person.
#
# Set to 0 ONLY on a deployment that already has verified users from before this
# rule, where turning it on would freeze live wallets whose owners were never
# asked for an account. Check before you decide:
#   SELECT count(*) FROM kyc_verifications
#    WHERE (status = 'verified' OR nin_slip_status = 'approved')
#      AND account_status <> 'verified';
# It was 0 when this shipped.
KYC_BANK_REQUIRED=1

# Retired with the BVN callback. The lookup is synchronous, so no submission ever
# sits `pending` and there is nothing to release.
# KYC_BVN_PENDING_STALE_MINUTES=30
# Edit distance tolerated per name token when matching a document against the
# profile name. 2 absorbs a slipped keystroke in a long Nigerian name; 0 turns
# the check into exact string equality and generates tickets. STILL LIVE.
KYC_NAME_MAX_EDITS=2

# Payvessel - the live KYC rail. Both checks (BVN and NIN) are SYNCHRONOUS: the
# verdict is in the HTTP response, so there is no callback and PUBLIC_BASE_URL
# is irrelevant to this path. Auth is two flat headers, api-key + api-secret;
# both are secret. The same key pair authenticates the VAAS/betting rail below.
#
# ⚠ Payvessel is PREPAID, and it bills a failed match and a "not found" exactly
# as it bills a pass. An empty balance answers 402, which the app surfaces as
# "temporarily unavailable" and which leaves the user's record untouched rather
# than marking them failed. This is what took the rail down last time - keep the
# balance funded and watch for kyc.* 503s in the logs.
PAYVESSEL_API_KEY=
PAYVESSEL_API_SECRET=
# https://sandbox.payvessel.com/kyc while testing.
PAYVESSEL_BASE_URL=https://api.payvessel.com/kyc
# Name-similarity floor, in percent. Below this the check is a decline.
# DO NOT RAISE THIS TO 70. Measured on a live three-name BVN (2026-08-25):
# Payvessel's BVN endpoint ignores `middle_name` entirely and scores
# (names matched / names on the register) over first and last only, so a
# three-name record CANNOT EXCEED 66 however perfectly it is filled in. At 70 no
# such customer can ever verify, and each pays N30 to find out. 65 accepts 66 and
# 100 while still declining a half match at 50 or 33. Full evidence in the
# NAME_MATCH_MIN comment in src/funding/payvessel.service.js.
PAYVESSEL_NAME_MATCH_MIN=65
# Payvessel biller reseller - the betting rail. Same api-key / api-secret pair
# as above, different host prefix, so only the base URL is separate. Betting
# was briefly moved to MySubWallet on 2026-10-06 and moved back the same day:
# MySubWallet's API has no bookmaker list, and its dashboard did not show the
# ids. Payvessel lists its billers, names and limits included, over the API.
# https://sandbox.payvessel.com while testing.
PAYVESSEL_VAAS_BASE_URL=https://api.payvessel.com
# Payvessel's floor for a betting order. A biller that publishes its own
# min_amount overrides this.
PAYVESSEL_BETTING_MIN_AMOUNT=100
# How often the server re-checks betting orders left processing. This is what
# refunds a failed order when the webhook never arrives, so do not disable it.
BETTING_SWEEP_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# USD Virtual Mastercard - Payvessel issuing. Same PAYVESSEL_API_KEY /
# PAYVESSEL_API_SECRET pair as above; nothing new to get from Payvessel except
# switching issuing on for the account and FUNDING ITS BUSINESS USD WALLET.
# ---------------------------------------------------------------------------
# Every card is issued and topped up FROM OUR Payvessel USD wallet. An empty
# wallet answers "insufficient balance" / 402, which the app shows as "briefly
# unavailable" (refunding the customer) and which pages ops via alerts - keep it
# funded ahead of demand. Prices, the dollar rate and the limits live in the
# admin dashboard (USD Cards > Settings); `npm run ddl:virtual-card` seeds the
# fees and limits. Two have NO default and must be set there first: the card
# CREATION PRICE (no card can be bought until it is set) and the dollar rate
# (top-ups stay off until it is set).
#
# https://sandbox.payvessel.com while testing. A sandbox host is refused when
# NODE_ENV=production.
PAYVESSEL_CARD_BASE_URL=https://api.payvessel.com
# THE CARD WEBHOOK IS REQUIRED - it carries purchases, declines and refunds in
# real time and is the only source of the customer's card pushes. Set
# Payvessel's dashboard webhook URL to ${PUBLIC_BASE_URL}/api/virtual-card/webhook
# (the admin's USD Cards page shows it ready to copy, and whether deliveries are
# arriving). Payvessel has refused URLs off the business website's own domain,
# so PUBLIC_BASE_URL must be that domain - e.g. a Render custom domain
# api.<domain> - not the onrender.com address. Deliveries are signed
# HMAC-SHA512 with the API secret and answered within Payvessel's 10s window.
# Money never waits on it: the sweep below settles every card and top-up if a
# delivery is lost.
# PAYVESSEL_WEBHOOK_SECRET=        # defaults to PAYVESSEL_API_SECRET
# PAYVESSEL_WEBHOOK_IPS=3.255.23.38,162.246.254.36   # opt-in; checked against req.ip
# Create runs Payvessel's KYC enrolment, so it gets longer than other calls.
VCARD_CREATE_TIMEOUT_MS=60000
# A dollar rate older than this stops top-ups until an admin confirms it
# (re-saving the same number counts). Naira moves daily.
VCARD_FX_MAX_AGE_HOURS=24
# A create or top-up whose answer was lost is refunded only after this long AND
# three successful reads of Payvessel that do not find it. Never shorter than
# Payvessel's own lag in listing a new card or transaction.
VCARD_CREATE_UNKNOWN_REFUND_AFTER_MS=1800000
VCARD_FUND_UNKNOWN_REFUND_AFTER_MS=1800000
# A card Payvessel keeps PENDING longer than this pages ops, once.
VCARD_PENDING_ALERT_AFTER_MS=7200000
# How long the app shows the full card number before hiding it (10-120).
VCARD_REVEAL_SECONDS=30
# The passport photo, decoded. The JSON body limit (JSON_BODY_LIMIT, 1mb) must
# fit it base64-encoded - about 4/3 of this.
VCARD_IMAGE_MAX_BYTES=600000
# A never-funded card gets one reminder this many days in (Payvessel closes
# unfunded cards at 21 days).
VCARD_FUND_REMINDER_DAYS=14
VCARD_SWEEP_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Fund Account - one account per user: PalmPay, through PaymentPoint, opened
# with the user's own NIN (reused from an approved NIN slip when there is one).
# Without these keys the screen says accounts are unavailable.
# ---------------------------------------------------------------------------
# Credits arrive at ${PUBLIC_BASE_URL}/api/funding/webhook - set that as the
# webhook URL on the PaymentPoint dashboard.
PAYMENTPOINT_API_KEY=
PAYMENTPOINT_SECRET_KEY=
PAYMENTPOINT_BUSINESS_ID=
# PalmPay's code on PaymentPoint. Only the first code is ever used - one user,
# one account.
PAYMENTPOINT_BANK_CODES=20946
# Defaults to PAYMENTPOINT_SECRET_KEY when unset.
# PAYMENTPOINT_WEBHOOK_SECRET=

# Kill switch cache. Deliberately short - a switch that takes ten minutes to
# take effect is not a kill switch. Flags themselves live in app_settings and
# are thrown from PATCH /admin/features/:slug.
FEATURE_FLAG_TTL_SECONDS=30

# Named admin keys: "name:role:key,name:role:key". Roles: support, finance,
# superadmin. Set this in production - it is what puts a name in the audit trail
# and lets one admin be removed without rotating everyone's access.
# ADMIN_API_SECRET below still works and authenticates as an anonymous
# superadmin, which is exactly the problem this replaces.
#
# Both are now superseded by real admin accounts (admin_users). Once every human
# has one, set ADMIN_ALLOW_STATIC_KEYS=0 and neither header is accepted again.
ADMIN_API_KEYS=

# Signs admin session tokens. Required for /admin/auth/login, and MUST be a
# different value from JWT_SECRET - a leaked customer token secret must not be
# able to mint admin sessions. 32+ random bytes.
ADMIN_JWT_SECRET=
# Admin sessions are short by design; the dashboard signs in again.
ADMIN_JWT_EXPIRES_IN=12h
# Set to 0 to reject ADMIN_API_KEYS / ADMIN_API_SECRET and accept only real
# admin accounts. Do this once the first superadmin can log in.
ADMIN_ALLOW_STATIC_KEYS=1
